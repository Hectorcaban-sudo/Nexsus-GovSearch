<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dismiss_Reason_Required</fullName>
    <active>true</active>
    <description>Require a dismiss reason when triage status is Dismiss.</description>
    <errorConditionFormula>AND(
        ISPICKVAL(Triage_Status__c, "Dismiss"),
        ISBLANK(Dismiss_Reason__c)
    )</errorConditionFormula>
    <errorDisplayField>Dismiss_Reason__c</errorDisplayField>
    <errorMessage>A dismiss reason is required when triage status is Dismiss.</errorMessage>
</ValidationRule>
