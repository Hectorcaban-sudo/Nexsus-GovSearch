<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Sample flow stub to create a Spark from a high-scoring opportunity or external lead.</description>
    <environments>Default</environments>
    <interviewLabel>Create Spark from Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Spark from Lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Spark_Record</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>LeadTitle</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
